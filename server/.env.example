# Порт сервера
PORT=3000
NODE_ENV=development

# Подключение к PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/market

# Секреты JWT — обязательно замените в продакшене
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret

# Время жизни access-токена и refresh-токена (дни)
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# Демо-режим: показывает демо-аккаунт и код сброса пароля в ответе API
DEMO_MODE=true